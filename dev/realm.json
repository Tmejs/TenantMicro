{
  "realm": "tenantmicro",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [{ "name": "PLATFORM_ADMIN" }]
  },
  "clients": [
    {
      "clientId": "tenantmicro-local",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8081/*"],
      "webOrigins": ["http://localhost:8081"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tenantmicro-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "platform-admin",
      "enabled": true,
      "email": "platform-admin@example.test",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "platform-admin-dev", "temporary": false }],
      "realmRoles": ["PLATFORM_ADMIN"]
    },
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "alice-dev", "temporary": false }]
    }
  ]
}
