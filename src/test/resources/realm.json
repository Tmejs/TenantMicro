{
  "realm": "tenantmicro-test",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [ { "name": "PLATFORM_ADMIN" } ]
  },
  "clients": [
    {
      "clientId": "tenantmicro-test",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tenantmicro-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wrong-audience-test",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.test",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "requiredActions": [],
      "credentials": [ { "type": "password", "value": "admin-pass", "temporary": false } ],
      "realmRoles": [ "PLATFORM_ADMIN" ]
    },
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "requiredActions": [],
      "credentials": [ { "type": "password", "value": "alice-pass", "temporary": false } ]
    }
  ]
